# Copy to restore.local.env next to this bundle (optional). Overrides manifest.env when restore runs.
# Do NOT use the filename .env in the bundle folder: docker-compose always loads .env there and
# can break MYSQL_ROOT_PASSWORD / init. Use restore.local.env only.

# New server public IP (used for WordPress IP binding / search-replace). Use 0.0.0.0 only for local-only.
WORDPRESS_IP=203.0.113.10

# If the site URL changes, set these (include port if you use :7171 in the browser).
# If unset, restore.sh builds http://${WORDPRESS_IP}:${WP_PUBLISH_PORT} for both.
# PUBLIC_SITEURL=http://203.0.113.10:7171
# PUBLIC_HOME=http://203.0.113.10:7171

WP_PUBLISH_PORT=7171
MYSQL_PUBLISH_PORT=3308

# Leave these unset — restore.sh uses MYSQL_USER / MYSQL_PASSWORD from manifest.env (required).
# Only set if you intentionally duplicate manifest into .env. Never use an empty value:
# an empty MYSQL_ROOT_PASSWORD in .env can break MySQL's first-time init.
# MYSQL_USER=wordpress
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
